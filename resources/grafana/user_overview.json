{
  "title": "IceProd User Overview",
  "uid": "iceprod-user-overview",
  "description": "IceProd tasks, jobs, and resources by dataset owner. Data from the dataset_monitor scheduled task. Queries take max by the series identity labels so pod/instance labels from successive CronJob runs are not double counted.",
  "tags": [
    "iceprod"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      },
      {
        "name": "username",
        "label": "User",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(iceprod_tasks, username)",
          "refId": "username"
        },
        "definition": "label_values(iceprod_tasks, username)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {}
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(iceprod_tasks{username=~\"$username\"}, group)",
          "refId": "group"
        },
        "definition": "label_values(iceprod_tasks{username=~\"$username\"}, group)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {}
      },
      {
        "name": "lookback",
        "label": "Lookback",
        "type": "custom",
        "query": "5m,15m,30m,1h",
        "description": "Window to carry forward the last dataset_monitor value. Set >= the CronJob interval.",
        "current": {
          "text": "15m",
          "value": "15m"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": true
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Processing tasks (now)",
      "description": "Tasks currently running on the grid.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (dataset, taskname, username, group, status) (last_over_time(iceprod_tasks{username=~\"$username\",group=~\"$group\",status=\"processing\"}[$lookback])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Processing tasks (avg over range)",
      "description": "Average number of running tasks over the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg_over_time((sum(max by (dataset, taskname, username, group, status) (last_over_time(iceprod_tasks{username=~\"$username\",group=~\"$group\",status=\"processing\"}[$lookback]))))[$__range:$lookback])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
