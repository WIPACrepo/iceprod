          "expr": "sum by (status) (max by (dataset, taskname, username, group, status) (last_over_time(iceprod_tasks{username=~\"$username\",group=~\"$group\",status=~\"idle|waiting|queued|processing|failed|suspended\"}[$lookback])))",
